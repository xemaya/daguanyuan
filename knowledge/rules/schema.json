{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "机读规则表",
  "type": "object",
  "required": [
    "source",
    "rules"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "book",
        "doc"
      ],
      "properties": {
        "book": {
          "type": "string",
          "description": "书名"
        },
        "doc": {
          "type": "string",
          "description": "对应研究稿目录，相对仓库根"
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "statement",
          "paramSet"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{2}-\\d{2}$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "contested",
              "refuted",
              "underdetermined",
              "missing"
            ],
            "description": "ok 通过 | contested 存疑(证据互相冲突,用 correction) | refuted 驳倒(禁用,引用即抛) | underdetermined 欠定(证据存在且不冲突,但不足以唯一决定结果——必须给 resolution,不得让美术决策伪装成考据结论) | missing 缺失(抛错并给 whereToLook)"
          },
          "statement": {
            "type": "string",
            "description": "现代中文表述"
          },
          "formula": {
            "type": "string",
            "description": "可编码公式；是表则写 \"table\""
          },
          "table": {
            "type": "array",
            "description": "formula 为 table 时的数据"
          },
          "params": {
            "type": "object"
          },
          "correction": {
            "type": "string",
            "description": "status=contested 时代码应采用的更正值"
          },
          "choices": {
            "type": "array",
            "description": "并存的多个口径。调用方必须显式选一个 key，否则 derive 抛 AmbiguousRuleError。",
            "items": {
              "type": "object",
              "required": [
                "key",
                "value",
                "note"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {},
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "quote": {
            "type": "string",
            "description": "原文逐字引文"
          },
          "location": {
            "type": "string",
            "description": "卷/篇/页"
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "依赖的规则 id"
          },
          "whereToLook": {
            "type": "object",
            "description": "status=missing 时，下一轮该查什么",
            "properties": {
              "books": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "paramSet": {
            "enum": [
              "fashi",
              "qing",
              "fayuan",
              "both",
              "none"
            ],
            "description": "哪条推导链消费这条规则。与文件名无关——文件按来源章节组织，参数集按消费方组织，两个轴不同。'none' 用于原文事实、花木名录、缺口条目。清《工程做法》06 章屋顶瓦作官式与苏式并存，逐条判归属，见 knowledge/rules/README.md。"
          },
          "resolution": {
            "type": "object",
            "description": "status=underdetermined 时必填:合法解不唯一,这里说明怎么定下来的。",
            "required": [
              "method",
              "note"
            ],
            "properties": {
              "method": {
                "enum": [
                  "artistic_choice",
                  "seeded_variant"
                ],
                "description": "artistic_choice 由艺术圣经定;seeded_variant 由种子生成多个都合法的变体"
              },
              "note": {
                "type": "string",
                "description": "合法解的范围,以及这次为什么这么定"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "componentFile": {
      "title": "构件级本体（components.rules.json）",
      "description": "与规则表并列但语义不同：规则表回答「多大」，构件本体回答「由什么组成、怎么装」。绝不存几何——不许出现顶点、网格、贴图路径这类字段，存了就从可执行的语法退化成古建资产库（ROADMAP P1 增补）。尺寸只引规则表的 id，不在这里重复数值。",
      "type": "object",
      "required": [
        "source",
        "components"
      ],
      "properties": {
        "source": {
          "type": "object",
          "required": [
            "book",
            "doc"
          ],
          "properties": {
            "book": {
              "type": "string"
            },
            "doc": {
              "type": "string",
              "description": "对应研究稿，相对仓库根；跨章汇编可列多篇"
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "category",
              "status",
              "paramSet"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C-",
                "description": "构件实体 id，C- 前缀，与规则表的数字 id 区分"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "斗拱",
                  "梁架",
                  "柱额",
                  "屋面",
                  "小木",
                  "石作"
                ]
              },
              "status": {
                "enum": [
                  "ok",
                  "contested",
                  "refuted",
                  "underdetermined",
                  "missing"
                ],
                "description": "与规则表同一状态机。构件的尺寸数值另有规则表条目各自带状态，此处只反映「组成与装配」这一陈述本身的核验状态"
              },
              "paramSet": {
                "enum": [
                  "fashi",
                  "qing",
                  "fayuan",
                  "both",
                  "none"
                ]
              },
              "statement": {
                "type": "string",
                "description": "现代中文表述：由什么组成、怎么装"
              },
              "parts": {
                "type": "array",
                "description": "下级分件的 id 与数量。只写组成，不写坐标；悬空的 ref 门会报。组装件有此字段，分件没有。",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "name",
                    "count"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^C-"
                    },
                    "name": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "attachTo": {
                "type": "object",
                "description": "装在哪个父件的什么位置，用词描述不用数",
                "required": [
                  "parent",
                  "position"
                ],
                "properties": {
                  "parent": {
                    "type": "string"
                  },
                  "position": {
                    "type": "string"
                  }
                }
              },
              "geometry": {
                "type": "object",
                "description": "形状族与该族的形状参数名。只列参数名，不列数值；数值由 dimensions 所引的规则按模数折算。组装件无此字段。",
                "required": [
                  "family",
                  "shapeParams"
                ],
                "properties": {
                  "family": {
                    "enum": [
                      "斗",
                      "栱",
                      "昂",
                      "枋",
                      "替木",
                      "椽",
                      "栓"
                    ]
                  },
                  "shapeParams": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "dimensions": {
                "type": "array",
                "description": "给尺寸的规则 id 列表，不在本体里重复数值。id 必须在该构件 paramSet 对应的规则表里存在，悬空的门会报。",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{2}-\\d{2}$"
                }
              },
              "source": {
                "type": "object",
                "required": [
                  "book",
                  "location"
                ],
                "properties": {
                  "book": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string",
                    "description": "卷/篇/页"
                  },
                  "quote": {
                    "type": "string",
                    "description": "原文逐字引文"
                  }
                }
              },
              "urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string",
                "description": "组配逻辑、存疑口径与参数化提醒"
              }
            }
          }
        }
      }
    }
  }
}